# AGC Scenario File — Entry Interface (Apollo-11, 122 km Höhe)
# Quelle: Apollo-11-Referenzwerte für den Entry Interface (EI)
#   v ≈ 10 900 m/s (inertial), γ = -6.5° unter Horizontale
# Referenz: "The Apollo Guidance Computer: Architecture and Operation",
#   Chapter 4 "Command Module entry" (Book S. 341–358 · PDF S. 357–374)
#
# γ       = -6.5° = -0.1134 rad
# r       = r_equatorial + 122_000 = 6_378_137 + 122_000 = 6_500_137 m
# vel_x   = v × cos(γ) = 10_900 × cos(-0.1134) ≈ 10834 m/s  (horizontal)
# vel_y   = v × sin(γ) = 10_900 × sin(-0.1134) ≈ -1238 m/s  (abwärts)
#
# Hinweis: pos_x_m verwendet r_equatorial (6 378 137 m), nicht den mittleren
# Erdradius (6 371 000 m), damit Höhenberechnungen in agc-core konsistent sind.

pos_x_m  = 6500137.0
pos_y_m  = 0.0
pos_z_m  = 0.0
vel_x_ms = 10834.0
vel_y_ms = -1238.0
vel_z_ms = 0.0
time_s   = 0.0
